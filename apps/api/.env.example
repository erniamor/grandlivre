NODE_ENV=development
PORT=3001
# Public URL of this API (used in sign-in links and OAuth callbacks)
API_URL=http://localhost:3001
# Public URL of the front end (used in the links sent by email)
APP_URL=http://localhost:3000
# Local database started with `pnpm --filter api db:up`
DATABASE_URL=postgres://grandlivre:grandlivre@localhost:5434/grandlivre
# Comma-separated list of front-end origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Signs sessions and tokens: at least 32 characters, generate one with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Email sending with Resend (required in production, both or none). Without them,
# emails are printed to the console. API key with "Sending access", restricted
# to the sender's domain, verified in Resend (EU region)
# RESEND_API_KEY=
# EMAIL_FROM=Grand Livre <grandlivre@example.com>
# Parent domain shared by the API and the front end in production, e.g.
# grandlivre.example.com for api.grandlivre.example.com: shares the session cookie.
# Leave unset in development (both run on localhost)
# COOKIE_DOMAIN=
# Google sign-in (optional, both or none): OAuth client from Google Cloud Console,
# with the redirect URI <API_URL>/v1/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Claude API key (optional): turns notes like "gas 72 $" into draft transactions.
# Without it, quick entry answers that the assistant is unavailable
# ANTHROPIC_API_KEY=
# How often, in seconds, the recurring transactions whose day has come are
# recorded or set aside for a member (900 by default; lower it to try them)
# RECURRING_RUN_EVERY_SECONDS=900

{
	"name": "grandlivre",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter api --filter www dev",
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"db:reset": "pnpm --filter api db:reset",
		"db:migrate": "pnpm --filter api db:migrate"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"typescript": "catalog:"
	},
	"volta": {
		"node": "24.22.2",
		"pnpm": "10.34.9"
	}
}
